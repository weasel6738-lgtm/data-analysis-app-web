# Runtime
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10

# Required AI providers for the deployed app
ORCHESTRATOR_PROVIDER=microsoft-agent
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Copilot SDK performs document topic grouping
DRAFT_PROVIDER=github-copilot
GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

# Frontend (set in frontend/.env.local for split deployments)
# VITE_API_URL=https://your-api.example.com
